{
    "name": "oninna-backend",
    "version": "0.1.0",
    "description": "ONINNA -- plain Node.js backend serving the homepage and a Postgres-backed API",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "node --test --test-concurrency=1",
        "db:migrate": "node src/db/migrate.js",
        "db:seed": "node src/db/seed.js",
        "db:reset": "node src/db/reset.js",
        "user:role": "node scripts/set-role.js",
        "bot": "node src/bots/worker.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "dotenv": "^16.4.5",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.11.5",
        "telegraf": "4.16.3"
    }
}
